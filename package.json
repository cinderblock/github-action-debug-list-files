{
  "name": "github-action-debug-list-files",
  "version": "1.0.0",
  "description": "GitHub Action that lists (with diff) files in a working directory. For debugging other actions.",
  "private": true,
  "type": "module",
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "MIT",
  "keywords": [
    "github-actions",
    "debugging",
    "file-listing"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=cjs --outfile=dist/index.js",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "format": "prettier --write .",
    "verify-dist": "bun run build && git diff --exit-code dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/github-action-debug-list-files.git"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "globby": "^16.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.19.19",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  }
}
